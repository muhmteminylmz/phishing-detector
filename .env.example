# ─────────────────────────────────────────────────────────────
# Phishing Detector — Ortam Değişkenleri / Environment Variables
# ─────────────────────────────────────────────────────────────
# Bu dosyayı .env olarak kopyala (setup.sh bunu otomatik yapar):
#   cp .env.example .env
#
# Docker ile çalıştırmak için aşağıdaki değerleri değiştirmene
# gerek yok — hepsi varsayılan olarak çalışır.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL Veritabanı / Database ────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=phishing_db

# Backend'in veritabanına bağlantı adresi (Docker içinde host = postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@postgres:5432/phishing_db

# ── Redis Cache ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Güvenlik / Security ─────────────────────────────────────
# setup.sh çalıştırıldığında otomatik üretilir.
# Elle oluşturmak için:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-run-setup-sh

# ── ML Modeli / ML Model ───────────────────────────────────
MODEL_PATH=./ml/models/ensemble_model.joblib

# ── Genel / General ────────────────────────────────────────
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
